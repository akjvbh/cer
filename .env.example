# 服务配置
PORT=8000
AUTO_OPEN_BROWSER=1
MAX_FILE_SIZE_MB=200
# 批量：最多文件数与总大小（MB）
MAX_BATCH_FILES=200
MAX_BATCH_SIZE_MB=500

# 任务与临时文件保留（秒）；后台默认每小时清理一次超过 1 小时的结果
TASK_TTL_SECONDS=3600
CLEANUP_INTERVAL_SECONDS=3600

# start.bat 会自动设为 1，把日志同时写入 _start_log.txt
START_LOG=

# Office COM 转换
OFFICE_ENABLED=1
OFFICE_TIMEOUT_SECONDS=600

# 文献翻译（OpenAI 兼容接口；密钥留空则界面禁用翻译）
TRANSLATE_API_KEY=
TRANSLATE_BASE_URL=https://api.deepseek.com/v1
TRANSLATE_MODEL=deepseek-chat